{
  "name": "@hostedbrands/shared-schema",
  "version": "2.0.2",
  "description": "Shared database schema for all Hosted Stack apps. Rebuilt from live Railway production DB on 2026-05-03.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tables": {
      "types": "./dist/tables.d.ts",
      "import": "./dist/tables.js",
      "default": "./dist/tables.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.39.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
